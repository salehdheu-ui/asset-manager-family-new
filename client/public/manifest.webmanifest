{
  "name": "صندوق العائلة",
  "short_name": "صندوق العائلة",
  "description": "إدارة صندوق العائلة: المساهمات والسلف والمصروفات والاستثمارات",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#e7eeeb",
  "theme_color": "#127247",
  "categories": ["finance", "productivity"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-dashboard.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "نظرة عامة على الصندوق"
    },
    {
      "src": "/screenshots/mobile-payments.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "سجل المساهمات الشهرية"
    },
    {
      "src": "/screenshots/mobile-loans.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "السلف وجدولة الأقساط"
    },
    {
      "src": "/screenshots/desktop-dashboard.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة الصندوق على الحاسب"
    }
  ],
  "shortcuts": [
    {
      "name": "السلف",
      "short_name": "السلف",
      "url": "/loans",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "المساهمات",
      "short_name": "المساهمات",
      "url": "/payments",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
